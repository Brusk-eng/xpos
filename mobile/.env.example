# Copy to .env.local (git-ignored). No credentials belong here: sign in on the login screen.

# Real development ERPNext 16 site the browser dev proxy forwards to (yarn dev).
XPOS_DEV_TARGET=http://127.0.0.1:8000
# Frappe site name when the bench serves several sites (sent as X-Frappe-Site-Name).
XPOS_DEV_SITE=site.local
# Optional: Host header to send instead (use if your bench routes by hostname).
# XPOS_DEV_HOST=site.local
# Optional: accept a self-signed certificate on the target (https dev servers only).
# XPOS_DEV_INSECURE_TLS=1

# Dev server port (default 5174).
# XPOS_DEV_PORT=5174
# Serve on the LAN so a phone or emulator can load it. Default: this machine only.
# XPOS_DEV_LAN=1
# Address the device uses to reach this machine for hot reload (LAN IP, or 10.0.2.2 for the Android emulator).
# XPOS_HMR_HOST=192.168.1.20

# Android live reload only: the URL the app loads. Debug builds only; the release build refuses it.
# XPOS_ANDROID_DEV=1
# CAP_LIVE_RELOAD_URL=http://192.168.1.20:5174
